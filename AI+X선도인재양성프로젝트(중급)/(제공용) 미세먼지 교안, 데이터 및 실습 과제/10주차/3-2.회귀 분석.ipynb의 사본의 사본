z":-540,"elapsed":9294,"user":{"displayName":"JW K","userId":"12247734576989807705"}}},"execution_count":3,"outputs":[]},{"cell_type":"code","source":["plt.rcParams['font.family'] = 'NanumGothic'\n","plt.rcParams['axes.unicode_minus'] = False"],"metadata":{"id":"p6gDuPDoRgUj","executionInfo":{"status":"ok","timestamp":1746717477457,"user_tz":-540,"elapsed":35,"user":{"displayName":"JW K","userId":"12247734576989807705"}}},"execution_count":4,"outputs":[]},{"cell_type":"markdown","source":["## 필요한 함수"],"metadata":{"id":"q2us6lLIVv_D"}},{"cell_type":"code","source":["def vif(dataframe, features):\n","    \"\"\"\n","    다중공선성(VIF)을 계산하는 함수 (const 자동 제거)\n","\n","    Parameters:\n","    - dataframe: pd.DataFrame\n","        입력 데이터프레임\n","    - features: list of str\n","        독립 변수(컬럼명) 리스트\n","\n","    Returns:\n","    - vif_df: pd.DataFrame\n","        독립 변수들과 해당하는 VIF 값을 담은 데이터프레임\n","        (const는 포함되지 않음)\n","    \"\"\"\n","    X = dataframe[features]\n","    X_const = add_constant(X)\n","\n","    vif_data = pd.DataFrame()\n","    vif_data[\"변수\"] = X_const.columns\n","    vif_data[\"VIF\"] = [variance_inflation_factor(X_const.values, i) for i in range(X_const.shape[1])]\n","\n","    # const 행 제거\n","    vif_data = vif_data[vif_data[\"변수\"] != \"const\"]\n","\n","    return vif_data"],"metadata":{"id":"KGffJ2pm29H5","executionInfo":{"status":"ok","timestamp":1746717477512,"user_tz":-540,"elapsed":53,"user":{"displayName":"JW K","userId":"12247734576989807705"}}},"execution_count":5,"outputs":[]},{"cell_type":"code","source":["import statsmodels.api as sm\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","import warnings\n","\n","def stepwise_feature_selection(X_train, y_train, variables=None, sl_enter=0.05, sl_remove=0.05):\n","    \"\"\"\n","    전진 선택 + 후진 제거를 통한 변수 선택\n","\n","    Parameters:\n","    - X_train: pd.DataFrame\n","    - y_train: pd.Series 또는 np.array\n","    - variables: 선택에 사용할 변수 리스트 (기본: X_train.columns)\n","    - sl_enter: 포함 기준 p-value\n","    - sl_remove: 제거 기준 p-value\n","\n","    Returns:\n","    - selected_variables: 최종 선택된 변수 리스트\n","    \"\"\"\n","    warnings.filterwarnings(\"ignore\")\n","\n","    if variables is None:\n","        variables = X_train.columns.tolist()\n","\n","    y = y_train.copy()\n","    selected_variables = []\n","    steps = []\n","    sv_per_step = []\n","    adjusted_r_squared = []\n","    step = 0\n","\n","    while len(variables) > 0:\n","        remainder = list(set(variables) - set(selected_variables))\n","        pval = pd.Series(index=remainder, dtype=float)\n","\n","        # 전진 선택\n","        for col in remainder:\n","            X = sm.add_constant(X_train[selected_variables + [col]])\n","            model = sm.OLS(y, X).fit()\n","            pval[col] = model.pvalues[col]\n","\n","        min_pval = pval.min()\n","\n","        if min_pval < sl_enter:\n","            best_var = pval.idxmin()\n","            selected_variables.append(best_var)\n","\n","            # 후진 제거\n","            while len(selected_variables) > 0:\n","                X_selected = sm.add_constant(X_train[selected_variables])\n","                model = sm.OLS(y, X_selected).fit()\n","                selected_pvals = model.pvalues.drop('const')\n","\n","                max_pval = selected_pvals.max()\n","                if max_pval >= sl_remove:\n","                    worst_var = selected_pvals.idxmax()\n","                    selected_variables.remove(worst_var)\n","                else:\n","                    break\n","\n","            # 결과 저장\n","            step += 1\n","            steps.append(step)\n","            sv_per_step.append(selected_variables.copy())\n","            adj_r2 = sm.OLS(y, sm.add_constant(X_train[selected_variables])).fit().rsquared_adj\n","            adjusted_r_squared.append(adj_r2)\n","\n","        else:\n","            break\n","\n","    # 그래프 출력\n","    plt.figure(figsize=(12, 6))\n","    plt.xticks(steps, [f'Step {s}\\n' + '\\n'.join(sv) for s, sv in zip(steps, sv_per_step)], fontsize=10)\n","    plt.plot(steps, adjusted_r_squared, marker='o', color='blue')\n","    plt.ylabel('Adjusted R Squared', fontsize=12)\n","    plt.xlabel('Step', fontsize=12)\n","    plt.title('Stepwise Feature Selection Progress', fontsize=14)\n","    plt.grid(True)\n","    plt.tight_layout()\n","    plt.show()\n","\n","    return selected_variables"],"metadata":{"id":"Qku8Lzk4gLl2","executionInfo":{"status":"ok","timestamp":1746717477513,"user_tz":-540,"elapsed":10,"user":{"displayName":"JW K","userId":"12247734576989807705"}}},"execution_count":6,"outputs":[]},{"cell_type":"markdown","source":["# [1] 데이터 셋 불러오기"],"metadata":{"id":"hkP8ECJgFXdB"}},{"cell_type":"code","source":["df_21 = pd.read_csv('/content/drive/MyDrive/AI+X/AI+X선도인재양성프로젝트(중급)/(제공용) 미세먼지 교안, 데이터 및 실습 과제/10주차/df_21.csv')\n","df_22 = pd.read_csv('/content/drive/MyDrive/AI+X/AI+X선도인재양성프로젝트(중급)/(제공용) 미세먼지 교안, 데이터 및 실습 과제/10주차/df_22.csv')"],"metadata":{"id":"iSSKJkZ-FR-l","executionInfo":{"status":"ok","timestamp":1746717480649,"user_tz":-540,"elapsed":3142,"user":{"displayName":"JW K","userId":"12247734576989807705"}}},"execution_count":7,"outputs":[]},{"cell_type":"code","source":["df_21.head(3)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":453},"id":"FGdtdhWlRiY0","executionInfo":{"status":"ok","timestamp":1746717480743,"user_tz":-540,"elapsed":86,"user":{"displayName":"JW K","userId":"12247734576989807705"}},"outputId":"3539a46d-c2ff-4927-b2ad-73ebf0ba2922"},"execution_count":8,"outputs":[{"output_type":"execute_result","data":{"text/plain":["                  time      지역    SO2   CO     O3    NO2  PM10  PM25  기온(°C)  \\\n","0  2021-01-01 01:00:00  서울 종로구  0.002  0.5  0.022  0.016  24.0  14.0    -8.7   \n","1  2021-01-01 02:00:00  서울 종로구  0.002  0.6  0.018  0.020  25.0  14.0    -9.1   \n","2  2021-01-01 03:00:00  서울 종로구  0.002  0.6  0.013  0.025  27